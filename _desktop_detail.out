import psutil
for p in psutil.process_iter(['pid','name','cmdline','status']):
    cmd=' '.join(p.info['cmdline'] or [])
    if 'desktop_app.py' in cmd:
        print('PID', p.info['pid'], 'NAME', p.info['name'], 'STATUS', p.info['status'])
        print('CMD', cmd)

